{
  "version": "1.4.8.freeze",
  "description": "C-5 Expression Scheduler Rules (一期固化)",
  "core_rule": "Vision is the only rhythm authority",
  "rules": [
    {
      "id": "critical_override",
      "when": {
        "vision_state": ["TURNING", "UNSTABLE"],
        "is_critical": true
      },
      "then": {
        "allow": true,
        "delay_strategy": "zero"
      }
    },
    {
      "id": "block_during_turning",
      "when": {
        "vision_state": "TURNING"
      },
      "then": {
        "allow": false
      }
    },
    {
      "id": "stable_high_priority",
      "when": {
        "vision_state": ["STABLE", "LOCKED"],
        "urgency": "high"
      },
      "then": {
        "allow": true,
        "delay_strategy": "vision_speed"
      }
    },
    {
      "id": "stable_low_priority",
      "when": {
        "vision_state": "STABLE",
        "urgency": "low"
      },
      "then": {
        "allow": true,
        "enqueue": true,
        "delay_strategy": "vision_speed"
      }
    },
    {
      "id": "stable_normal_priority",
      "when": {
        "vision_state": ["STABLE", "LOCKED"],
        "urgency": "normal"
      },
      "then": {
        "allow": true,
        "delay_strategy": "vision_speed"
      }
    },
    {
      "id": "unstable_block",
      "when": {
        "vision_state": "UNSTABLE",
        "is_critical": false
      },
      "then": {
        "allow": false
      }
    },
    {
      "id": "searching_block",
      "when": {
        "vision_state": "SEARCHING",
        "is_critical": false
      },
      "then": {
        "allow": false
      }
    }
  ]
}
