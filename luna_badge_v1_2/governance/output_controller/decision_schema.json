{
  "_comment": "决策 Schema - 定义模型输出治理决策的结构规范",
  "description": "MOC 返回给 TaskChain 的统一决策结构",
  "schema": {
    "decision": {
      "type": "string",
      "enum": ["commit", "fallback", "abort"],
      "description": "最终决策：commit=采用模型输出, fallback=使用兜底策略, abort=中止任务"
    },
    "selected_result": {
      "type": "object",
      "description": "被选中的模型输出（decision=commit 时有效）"
    },
    "reason": {
      "type": "string",
      "description": "决策原因说明"
    },
    "used_model": {
      "type": "object",
      "properties": {
        "model_id": {
          "type": "string",
          "description": "被采用的模型ID"
        },
        "version": {
          "type": "string",
          "description": "模型版本号"
        }
      }
    },
    "confidence": {
      "type": ["number", "null"],
      "description": "决策置信度（v1.5 暂不使用，保留为 null）"
    },
    "fallback_plan": {
      "type": ["string", "null"],
      "description": "fallback 计划标识（decision=fallback 时有效）"
    },
    "decision_trace": {
      "type": "object",
      "properties": {
        "task_domain": {
          "type": "string",
          "description": "任务领域"
        },
        "rules_applied": {
          "type": "array",
          "items": {"type": "string"},
          "description": "应用的规则列表"
        },
        "conflicts_detected": {
          "type": "array",
          "items": {"type": "object"},
          "description": "检测到的冲突列表"
        }
      }
    }
  }
}





