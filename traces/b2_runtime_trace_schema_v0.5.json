{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "B2 Runtime Trace Schema v0.5",
  "description": "B2 Runtime Trace 完整结构定义（强可视 · 强可追溯 · 强约束）",
  "type": "object",
  "required": [
    "meta",
    "time",
    "runtime_state",
    "state_gate",
    "perception",
    "trigger",
    "rule_evaluation",
    "impact_evaluation",
    "decision",
    "to_c_message",
    "writeback"
  ],
  "properties": {
    "meta": {
      "type": "object",
      "description": "运行上下文",
      "required": ["b_version", "trace_version"],
      "properties": {
        "b_version": {
          "type": "string",
          "description": "B2 版本号",
          "example": "0.5.0"
        },
        "trace_version": {
          "type": "string",
          "description": "Trace schema 版本",
          "example": "0.5"
        },
        "video_id": {
          "type": ["string", "null"],
          "description": "视频 ID（可选）"
        },
        "camera_id": {
          "type": ["string", "null"],
          "description": "相机 ID（可选）"
        },
        "build_hash": {
          "type": ["string", "null"],
          "description": "构建哈希（可选）"
        }
      }
    },
    "time": {
      "type": "object",
      "description": "统一人类时间视角",
      "required": ["ts", "frame_id", "fps", "human_time"],
      "properties": {
        "ts": {
          "type": "number",
          "description": "时间戳（秒，精确到毫秒）"
        },
        "frame_id": {
          "type": "integer",
          "description": "帧 ID"
        },
        "fps": {
          "type": "number",
          "description": "视频帧率"
        },
        "human_time": {
          "type": "string",
          "description": "人类可读时间（格式：MM:SS.mmm）",
          "pattern": "^\\d{2}:\\d{2}\\.\\d{3}$"
        }
      }
    },
    "runtime_state": {
      "type": "object",
      "description": "B2 Runtime State Machine 状态信息",
      "required": ["state", "since", "reason"],
      "properties": {
        "state": {
          "type": "string",
          "enum": ["INIT", "WARMING_UP", "SUSPENDED", "ACTIVE", "READ_ONLY", "ERROR"],
          "description": "当前运行时状态"
        },
        "since": {
          "type": "string",
          "description": "进入当前状态的时间（格式：MM:SS 或 X.Xs）"
        },
        "reason": {
          "type": "string",
          "description": "进入当前状态的原因"
        }
      }
    },
    "state_gate": {
      "type": "object",
      "description": "状态门控信息",
      "required": ["can_trigger"],
      "properties": {
        "can_trigger": {
          "type": "boolean",
          "description": "是否允许触发判断"
        },
        "blocked_by": {
          "type": ["string", "null"],
          "description": "如果被阻止，原因是什么（can_trigger=false 时必须提供）",
          "enum": [
            null,
            "window_not_ready",
            "imu_unstable",
            "camera_shake",
            "distance_invalid",
            "system_overload",
            "forced_read_only",
            "state: INIT",
            "state: WARMING_UP",
            "state: SUSPENDED",
            "state: READ_ONLY",
            "state: ERROR"
          ]
        }
      }
    },
    "perception": {
      "type": "object",
      "description": "事实层，不解释",
      "required": ["factors"],
      "properties": {
        "factors": {
          "type": "object",
          "description": "因子感知结果",
          "additionalProperties": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "required": ["score", "source"],
                "properties": {
                  "score": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "source": {
                    "type": "string",
                    "description": "数据来源",
                    "example": "vision"
                  },
                  "raw_hint": {
                    "type": ["string", "null"],
                    "description": "原始提示（可选）",
                    "example": "edge_discontinuity"
                  }
                }
              }
            ]
          }
        }
      }
    },
    "trigger": {
      "type": "object",
      "description": "是否进入判断链路",
      "required": ["triggered", "reason"],
      "properties": {
        "triggered": {
          "type": "boolean"
        },
        "reason": {
          "type": "string",
          "description": "触发或未触发的原因"
        },
        "trigger_ts": {
          "type": ["number", "null"],
          "description": "触发时间戳（triggered=true 时存在）"
        },
        "trigger_frame": {
          "type": ["integer", "null"],
          "description": "触发帧 ID（triggered=true 时存在）"
        },
        "trigger_factor": {
          "type": ["string", "null"],
          "description": "触发因子（triggered=true 时存在）"
        }
      }
    },
    "rule_evaluation": {
      "type": "array",
      "description": "规则执行轨迹",
      "items": {
        "type": "object",
        "required": ["rule_id", "input", "result"],
        "properties": {
          "rule_id": {
            "type": "string",
            "description": "规则 ID",
            "example": "PATH_SAFETY_V1"
          },
          "input": {
            "type": "object",
            "description": "规则输入",
            "properties": {
              "score": {
                "type": ["number", "null"]
              },
              "threshold": {
                "type": "number"
              }
            }
          },
          "result": {
            "type": "string",
            "description": "规则执行结果",
            "enum": ["PASS", "FAIL", "SKIP"]
          },
          "expression": {
            "type": ["string", "null"],
            "description": "规则表达式（可选）"
          }
        }
      }
    },
    "impact_evaluation": {
      "type": "object",
      "description": "内部真实语义",
      "required": ["impact"],
      "properties": {
        "impact": {
          "type": "string",
          "enum": ["NO_OP", "NEED_SLOW_DOWN", "PATH_UNCERTAIN", "NEED_DETOUR", "NEED_STOP"],
          "description": "行为影响评估"
        },
        "confidence": {
          "type": ["number", "null"],
          "description": "置信度（0-1）"
        },
        "derived_from": {
          "type": ["string", "null"],
          "description": "来源因子",
          "example": "path"
        },
        "reason": {
          "type": ["string", "null"],
          "description": "原因描述",
          "example": "surface_discontinuity_ahead"
        }
      }
    },
    "decision": {
      "type": "object",
      "description": "对外粗粒度决策",
      "required": ["level", "silent"],
      "properties": {
        "level": {
          "type": "string",
          "enum": ["NOTICE", "CONDITION_CHANGE", "INTERRUPT"],
          "description": "决策级别"
        },
        "silent": {
          "type": "boolean",
          "description": "是否沉默（不进入 timeline）"
        }
      }
    },
    "to_c_message": {
      "type": "object",
      "description": "是否真的"说出口"",
      "required": ["sent"],
      "properties": {
        "sent": {
          "type": "boolean",
          "description": "是否发送消息给 C"
        },
        "reason": {
          "type": ["string", "null"],
          "description": "如果不发送，原因是什么"
        },
        "payload": {
          "type": ["object", "null"],
          "description": "消息内容（sent=true 时存在）",
          "properties": {
            "impact": {
              "type": "string"
            },
            "main_factor": {
              "type": ["string", "null"]
            },
            "confidence": {
              "type": ["number", "null"]
            },
            "time_window": {
              "type": ["string", "null"],
              "description": "有效期",
              "example": "next_3s"
            }
          }
        }
      }
    },
    "writeback": {
      "type": "object",
      "description": "系统副作用",
      "required": ["timeline_written", "health_log_written", "memory_written"],
      "properties": {
        "timeline_written": {
          "type": "boolean",
          "description": "是否写入 timeline"
        },
        "health_log_written": {
          "type": "boolean",
          "description": "是否写入健康日志"
        },
        "memory_written": {
          "type": "boolean",
          "description": "是否写入记忆"
        }
      }
    }
  }
}
