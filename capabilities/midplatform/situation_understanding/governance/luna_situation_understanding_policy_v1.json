{
  "schema_id": "LunaSituationUnderstandingPolicyV1",
  "version": "v1",
  "phase_ref": "Phase-P1-Midplatform-Luna-Situation-Understanding-Model-Planning-v1-001",
  "layer_id": "L1_Situation_Understanding",
  "planning_only": true,
  "principle": "Runner 可以提供 evidence，但不能拥有 scene。Situation Understanding 输出是 candidate，不是 fact。",
  "rules": [
    {"rule_id": "situation_candidate_not_fact", "description": "Situation Understanding 输出不是事实"},
    {"rule_id": "no_runner_invocation", "description": "不得直接触发 runner"},
    {"rule_id": "no_tool_install", "description": "不得安装或下载工具"},
    {"rule_id": "no_fact_admission_bypass", "description": "不得绕过 Fact Admission"},
    {"rule_id": "no_navigation_decision", "description": "不得直接输出导航决策"},
    {"rule_id": "scene_profile_owned_by_situation_layer", "description": "scene_profile 由 Situation Layer 归纳"},
    {"rule_id": "runner_scene_hint_candidate_only", "description": "runner scene_hint 只能作为 visual_evidence_candidate"},
    {"rule_id": "teacher_output_not_direct_situation", "description": "teacher 输出须经 Network-Assisted Learning review"},
    {"rule_id": "case_library_reference_not_fact", "description": "case library 仅作参考案例"},
    {"rule_id": "human_correction_not_ground_truth", "description": "human correction 不是 ground truth"},
    {"rule_id": "text_task_no_default_slam", "description": "read_text/identify_place 不得默认激活 SLAM"},
    {"rule_id": "shopfront_sign_prefers_ocr", "description": "shopfront_sign 默认 OCR likely_needed，SLAM/Tracking/Depth not_needed"},
    {"rule_id": "subway_direction_prefers_ocr", "description": "subway_platform + find_direction 默认 OCR likely_needed"},
    {"rule_id": "street_crossing_prefers_detection_depth_tracking", "description": "street_crossing + assess_walkable 默认 Detection/Depth/Tracking"},
    {"rule_id": "corridor_prefers_spatial_tools", "description": "corridor + assess_walkable 默认 Depth/SLAM"},
    {"rule_id": "unknown_scene_requires_uncertainty", "description": "unknown_scene 必须输出 uncertainty 和 fallback"},
    {"rule_id": "all_outputs_traceable", "description": "所有输出必须有 evidence_refs/case_refs/trace_refs"},
    {"rule_id": "candidate_only_required", "description": "所有核心输出必须 candidate_only=true"},
    {"rule_id": "no_blanket_model_activation", "description": "未知场景禁止 blanket activate 所有模型"}
  ],
  "scene_capability_defaults": {
    "shopfront_sign": {"likely_needed": ["ocr"], "not_needed": ["slam", "tracking", "depth"]},
    "subway_platform": {"likely_needed": ["ocr"], "not_needed": ["slam"]},
    "street_crossing": {"likely_needed": ["detection", "depth", "tracking"]},
    "corridor": {"likely_needed": ["depth", "slam"]},
    "unknown_scene": {"likely_needed": [], "optional": ["vlm"]}
  },
  "boundary_flags": {
    "situation_candidate_not_fact": true,
    "no_runner_invocation": true,
    "no_tool_install": true,
    "no_fact_admission_bypass": true,
    "no_navigation_decision": true,
    "scene_profile_owned_by_situation_layer": true,
    "runner_scene_hint_candidate_only": true,
    "teacher_output_not_direct_situation": true,
    "case_library_reference_not_fact": true,
    "human_correction_not_ground_truth": true,
    "text_task_no_default_slam": true,
    "shopfront_sign_prefers_ocr": true,
    "subway_direction_prefers_ocr": true,
    "street_crossing_prefers_detection_depth_tracking": true,
    "corridor_prefers_spatial_tools": true,
    "unknown_scene_requires_uncertainty": true,
    "all_outputs_traceable": true,
    "candidate_only_required": true,
    "no_blanket_model_activation": true,
    "planning_only": true
  }
}
