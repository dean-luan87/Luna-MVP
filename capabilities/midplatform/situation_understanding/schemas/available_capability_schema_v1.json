{
  "schema_id": "AvailableCapabilityV1",
  "version": "v1",
  "candidate_only": true,
  "not_fact": true,
  "required_fields": ["capability_id", "capability_type", "availability"],
  "field_definitions": {
    "capability_id": { "type": "string" },
    "capability_type": {
      "enum": ["ocr", "detection", "sam", "slam", "depth", "tracking", "vlm",
        "search", "map", "speech", "other"]
    },
    "availability": { "enum": ["available", "unavailable", "unknown"] },
    "cost_hint": { "type": "string" },
    "latency_hint": { "type": "string" },
    "local_or_remote": { "type": "string" },
    "permission_required": { "type": "boolean" },
    "candidate_only": { "type": "boolean", "const": true },
    "not_fact": { "type": "boolean", "const": true }
  },
  "trace_refs": { "type": "array" },
  "policy_refs": ["luna_situation_understanding_policy_v1"]
}
