{
  "schema_id": "LunaAgentPlanningPolicyV1",
  "version": "v1",
  "phase_ref": "Phase-P1-Midplatform-Luna-Agent-Planning-Layer-Concept-Planning-v1-001",
  "layer_id": "L2_Agent_Planning",
  "planning_only": true,
  "principle": "Agent Planning 输出 plan candidate，不执行工具、不写 fact；工具执行必须经 Tool OS handoff。",
  "rules": [
    {"rule_id": "agent_plan_candidate_not_fact", "description": "Agent plan 是候选计划，不是事实"},
    {"rule_id": "no_runner_invocation", "description": "不得直接触发 runner"},
    {"rule_id": "no_tool_execution", "description": "不得直接执行工具"},
    {"rule_id": "no_tool_install", "description": "不得直接安装或下载工具"},
    {"rule_id": "tool_os_handoff_required", "description": "所有工具执行必须进入 Tool OS handoff candidate"},
    {"rule_id": "runner_admission_required", "description": "涉及 runner 的工具必须标记 runner_admission_required"},
    {"rule_id": "fact_admission_required_after_result", "description": "工具结果须经 Fact Admission，不得由 Agent Planning 写 fact"},
    {"rule_id": "situation_input_required", "description": "必须依赖 situation_understanding_candidate"},
    {"rule_id": "missing_information_drives_plan", "description": "plan steps 由 missing_information / task_clues / user_goal 驱动"},
    {"rule_id": "text_goal_prefers_ocr_plan", "description": "read_text / identify_place 优先 OCR tool plan"},
    {"rule_id": "text_goal_no_default_slam_plan", "description": "文字目标不得默认生成 SLAM tool plan"},
    {"rule_id": "street_crossing_prefers_risk_assessment_plan", "description": "street_crossing + assess_walkable 优先 Detection/Depth/Tracking"},
    {"rule_id": "corridor_navigation_prefers_spatial_plan", "description": "corridor + navigate 优先 Depth/SLAM"},
    {"rule_id": "unknown_scene_asks_user_or_vlm", "description": "unknown_scene 必须 ask_user 或 VLM/manual_review"},
    {"rule_id": "noop_plan_required", "description": "L1 not_needed 能力必须生成 noop_tool_plan_candidate"},
    {"rule_id": "no_blanket_tool_plan", "description": "不得为所有工具生成 tool plan"},
    {"rule_id": "all_steps_traceable", "description": "plan steps 必须 trace 到 L1 / policy"},
    {"rule_id": "human_correction_not_ground_truth", "description": "Human correction 只影响 plan candidate"}
  ],
  "boundary_flags": {
    "agent_plan_candidate_not_fact": true,
    "no_runner_invocation": true,
    "no_tool_execution": true,
    "no_tool_install": true,
    "tool_os_handoff_required": true,
    "runner_admission_required": true,
    "fact_admission_required_after_result": true,
    "situation_input_required": true,
    "missing_information_drives_plan": true,
    "text_goal_prefers_ocr_plan": true,
    "text_goal_no_default_slam_plan": true,
    "street_crossing_prefers_risk_assessment_plan": true,
    "corridor_navigation_prefers_spatial_plan": true,
    "unknown_scene_asks_user_or_vlm": true,
    "noop_plan_required": true,
    "no_blanket_tool_plan": true,
    "all_steps_traceable": true,
    "human_correction_not_ground_truth": true,
    "planning_only": true
  }
}
