{
  "schema_id": "QwenVLTeacherGovernancePolicyV1",
  "version": "v1",
  "phase_ref": "Phase-P1-Midplatform-Single-Teacher-QwenVL-Integration-Planning-v1-001",
  "provider_id": "qwen_vl",
  "teacher_role": "perception_teacher",
  "planning_only": true,
  "deterministic_mock_only": true,
  "principle": "Qwen-VL 是 Perception Teacher，只输出 teacher_evidence_candidate；Luna 保留 scene/plan/fact 所有权。",
  "rules": [
    {"rule_id": "qwen_not_scene_owner", "description": "Qwen 不得成为 L1 scene owner"},
    {"rule_id": "qwen_not_plan_owner", "description": "Qwen 不得覆盖 L2 selected plan"},
    {"rule_id": "qwen_not_fact_source", "description": "Qwen 输出不是 fact 来源"},
    {"rule_id": "qwen_not_execution_controller", "description": "Qwen 不调度工具、不触发 runner"},
    {"rule_id": "evidence_only_output", "description": "只输出 teacher_evidence_candidate"},
    {"rule_id": "validation_required", "description": "必须经过 luna_teacher_validation_processor 审核"},
    {"rule_id": "trace_required", "description": "输出必须带 trace_refs"},
    {"rule_id": "uncertainty_required", "description": "输出必须保留 uncertainty"},
    {"rule_id": "perception_teacher_only", "description": "本阶段只开放 perception_teacher"},
    {"rule_id": "no_real_api_in_planning", "description": "规划阶段禁止真实 Qwen API"},
    {"rule_id": "reject_slam_for_text", "description": "文字任务拒绝 SLAM 空间建图建议"},
    {"rule_id": "reject_unsupported_brand_claim", "description": "无 OCR 证据的品牌断言拒绝"},
    {"rule_id": "allowed_input_from_evidence_layer", "description": "输入仅来自 Luna Evidence Layer"},
    {"rule_id": "future_multi_teacher_ready", "description": "接口预留多 Teacher 仲裁扩展"}
  ],
  "allowed_evidence_types": [
    "scene_hypothesis_candidate",
    "visual_attention_candidate",
    "task_clue_candidate"
  ],
  "forbidden_output_types": [
    "fact_label",
    "confirmed_scene",
    "final_plan",
    "tool_execution",
    "teacher_result",
    "teacher_fact",
    "teacher_decision"
  ],
  "boundary_flags": {
    "qwen_not_scene_owner": true,
    "qwen_not_plan_owner": true,
    "qwen_not_fact_source": true,
    "qwen_not_execution_controller": true,
    "evidence_only_output": true,
    "validation_required": true,
    "trace_required": true,
    "uncertainty_required": true,
    "perception_teacher_only": true,
    "no_real_api": true,
    "no_network": true,
    "no_tool_execution": true,
    "no_runner_invocation": true,
    "no_fact_write": true,
    "no_direct_training": true,
    "future_multi_teacher_ready": true
  }
}
