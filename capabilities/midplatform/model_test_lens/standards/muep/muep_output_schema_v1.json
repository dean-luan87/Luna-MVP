{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "schema_id": "muep_output_schema_v1",
  "title": "MUEP Output V1",
  "type": "object",
  "required": ["prediction", "metrics", "failure_modes", "confidence"],
  "properties": {
    "protocol_version": { "type": "string", "const": "muep_v1" },
    "prediction": { "type": "object" },
    "intermediate": { "type": "object" },
    "metrics": {
      "type": "object",
      "required": ["layer_a_task", "layer_b_robustness", "layer_c_structural", "final_score"],
      "properties": {
        "layer_a_task": {
          "type": "object",
          "description": "Task correctness: IoU, ATE, WER, accuracy, etc.",
          "properties": {
            "primary_metric_name": { "type": "string" },
            "primary_metric_value": { "type": "number" },
            "primary_metric_score_normalized": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        },
        "layer_b_robustness": {
          "type": "object",
          "properties": {
            "noise_sensitivity": { "type": "number" },
            "low_light_degradation": { "type": "number" },
            "motion_blur_sensitivity": { "type": "number" },
            "scale_change_sensitivity": { "type": "number" },
            "robustness_score_normalized": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        },
        "layer_c_structural": {
          "type": "object",
          "properties": {
            "structural_quality_score_normalized": { "type": "number", "minimum": 0, "maximum": 1 },
            "notes": { "type": "array", "items": { "type": "string" } }
          }
        },
        "final_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "0.6*task + 0.25*robustness + 0.15*structural"
        },
        "scoring_weights": {
          "type": "object",
          "properties": {
            "task": { "const": 0.6 },
            "robustness": { "const": 0.25 },
            "structural": { "const": 0.15 }
          }
        }
      }
    },
    "failure_modes": {
      "type": "array",
      "items": { "type": "string" }
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
  }
}
