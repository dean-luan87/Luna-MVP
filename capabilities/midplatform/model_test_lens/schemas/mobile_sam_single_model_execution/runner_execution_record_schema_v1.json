{
  "schema_id": "RunnerExecutionRecordSchemaV1",
  "version": "v1",
  "phase_ref": "Phase-P1-Midplatform-Model-Test-Lens-MobileSAM-Single-Model-Execution-Integration-v1-002",
  "description": "受控 runner 执行记录。completed 仅表示模型运行完成，不代表 fact=true。",
  "required_fields": [
    "execution_id",
    "source_execution_candidate_id",
    "model_name",
    "model_version",
    "start_time",
    "end_time",
    "status",
    "input_ref",
    "output_ref",
    "trace_chain"
  ],
  "field_definitions": {
    "execution_id": { "type": "string", "pattern": "^rex_mobile_sam_" },
    "source_execution_candidate_id": { "type": "string", "pattern": "^crec_" },
    "model_name": { "type": "string", "enum": ["MobileSAM", "mobile_sam"] },
    "model_version": { "type": "string" },
    "start_time": { "type": "string", "format": "date-time" },
    "end_time": { "type": "string", "format": "date-time" },
    "status": {
      "type": "string",
      "enum": ["completed", "rejected", "failed", "timeout"]
    },
    "input_ref": { "type": "string" },
    "output_ref": { "type": "string" },
    "trace_chain": { "type": "array" },
    "runner_execution_completed_not_fact": { "type": "boolean", "const": true },
    "not_fact": { "type": "boolean", "const": true },
    "candidate_only": { "type": "boolean", "const": true }
  },
  "boundary_flags": {
    "completed_not_fact": true,
    "runner_execution_requires_execution_candidate": true,
    "runner_execution_requires_sandbox": true
  }
}
