{
  "schema_id": "MobileSamControlledExecutionInputPolicyV1",
  "version": "v1",
  "phase_ref": "Phase-P1-Midplatform-Model-Test-Lens-MobileSAM-Single-Model-Execution-Integration-v1-001",
  "description": "MobileSAM 受控执行输入边界。",
  "runner_type": "Segmentation",
  "model_id": "mobile_sam",
  "allowed_inputs": [
    "region_crop",
    "region_geometry_ref",
    "source_image_ref",
    "source_frame_ref",
    "prompt_label_candidate",
    "envelope_ref",
    "route_reason"
  ],
  "input_field_rules": {
    "prompt_label_candidate": {
      "role": "candidate_only",
      "forbidden_as": ["fact_label", "ground_truth", "segmentation_ground_truth"]
    },
    "region_crop": {
      "required_for_execution": true,
      "derived_from": "source_region_id"
    },
    "human_correction_read_hint": {
      "role": "priority_signal_only",
      "forbidden_as": ["ground_truth_mask", "expected_segmentation_output"]
    }
  },
  "forbidden_inputs": [
    "fact_label",
    "confirmed_object_name",
    "navigation_context",
    "human_correction_as_segmentation_truth",
    "internal_store_object",
    "preset_mask_as_truth"
  ],
  "crop_policy": {
    "mode": "region_bounding_with_padding",
    "padding_ratio": 0.05,
    "must_preserve_source_region_id": true,
    "invalid_crop_error": "invalid_crop"
  },
  "boundary_flags": {
    "mobile_sam_input_does_not_contain_fact_label": true,
    "no_human_correction_ground_truth": true,
    "no_prompt_label_fact_upgrade": true,
    "prompt_label_as_truth_forbidden": true,
    "adapter_input_normalized": true
  }
}
