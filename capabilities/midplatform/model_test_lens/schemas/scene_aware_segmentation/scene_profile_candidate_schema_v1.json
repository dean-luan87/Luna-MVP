{
  "schema_id": "SceneProfileCandidateSchemaV1",
  "version": "v1",
  "phase_ref": "Phase-P1-Midplatform-Scene-Aware-Segmentation-Prompt-Policy-Planning-v1-001",
  "description": "场景 profile 候选。仅用于选择 segmentation prompt policy，不是 fact。",
  "planning_only": true,
  "candidate_only": true,
  "not_fact": true,
  "required_fields": [
    "scene_profile_id",
    "scene_type_candidate",
    "confidence",
    "candidate_only",
    "not_fact"
  ],
  "field_definitions": {
    "scene_profile_id": {
      "type": "string",
      "description": "Stable id for this profile candidate instance"
    },
    "scene_type_candidate": {
      "type": "string",
      "enum": [
        "outdoor_street",
        "subway_platform",
        "indoor_station",
        "indoor_mall",
        "corridor",
        "store_front",
        "unknown_scene"
      ],
      "description": "Scene type candidate — not confirmed scene fact"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Heuristic confidence for profile selection"
    },
    "evidence_refs": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Optional refs to visual cues / metadata used for inference"
    },
    "source_image_ref": {
      "type": "string",
      "description": "Input image reference"
    },
    "inference_method": {
      "type": "string",
      "enum": ["rule_based_v1", "metadata_hint_v1", "manual_override_v1", "unknown_v1"],
      "default": "rule_based_v1"
    },
    "candidate_only": {
      "type": "boolean",
      "const": true
    },
    "not_fact": {
      "type": "boolean",
      "const": true
    },
    "scene_profile_candidate_not_fact": {
      "type": "boolean",
      "const": true
    },
    "must_not_enter_fact_layer": {
      "type": "boolean",
      "const": true
    },
    "must_not_trigger_navigation": {
      "type": "boolean",
      "const": true
    }
  },
  "boundary_flags": {
    "scene_profile_candidate_not_fact": true,
    "no_fact_write": true,
    "no_navigation_decision": true,
    "planning_only": true
  },
  "forbidden_upgrades": [
    "scene_type_candidate_as_fact",
    "scene_profile_as_navigation_context_fact",
    "scene_profile_as_prompt_label_fact"
  ],
  "example_subway_smoke": {
    "scene_profile_id": "spc_subway_jiahuihu_v1_001",
    "scene_type_candidate": "subway_platform",
    "confidence": 0.82,
    "evidence_refs": [
      "visual_cue:platform_screen_door",
      "visual_cue:overhead_direction_sign",
      "asset:ocr_real_image_subway_platform_jiahuihu_v1_001.png"
    ],
    "source_image_ref": "capabilities/test_assets/p1/ocr/ocr_real_image_subway_platform_jiahuihu_v1_001.png",
    "inference_method": "rule_based_v1",
    "candidate_only": true,
    "not_fact": true,
    "scene_profile_candidate_not_fact": true
  }
}
