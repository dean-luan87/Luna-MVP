{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "schema_id": "perception_hud_overlay_layer_schema_v1",
  "title": "Perception HUD Overlay Layer V1",
  "description": "HUD overlay layer for robot vision annotation display. Read-only; candidate-only.",
  "type": "object",
  "required": [
    "hud_layer_id",
    "layer_type",
    "visible_by_default",
    "opacity",
    "candidate_only"
  ],
  "properties": {
    "hud_layer_id": { "type": "string" },
    "layer_type": {
      "type": "string",
      "enum": [
        "object_box",
        "segmentation_mask",
        "ocr_text_box",
        "keypoint",
        "trajectory",
        "risk_marker",
        "attention_marker",
        "reasoning_callout",
        "spatial_label",
        "uncertainty_marker"
      ]
    },
    "source_image_ref": { "type": "string" },
    "artifact_ref": { "type": "string" },
    "label": { "type": "string" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "visible_by_default": { "type": "boolean" },
    "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
    "label_visible": { "type": "boolean" },
    "confidence_visible": { "type": "boolean" },
    "task_relevance_visible": { "type": "boolean" },
    "uncertainty_visible": { "type": "boolean" },
    "spatial_relation": { "type": "string" },
    "task_relevance": { "type": "string" },
    "uncertainty_tags": { "type": "array", "items": { "type": "string" } },
    "color_policy": { "type": "string" },
    "geometry": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["box", "mask", "polygon", "point", "polyline"] },
        "data_ref": { "type": "string" }
      }
    },
    "candidate_only": { "type": "boolean", "const": true }
  }
}
