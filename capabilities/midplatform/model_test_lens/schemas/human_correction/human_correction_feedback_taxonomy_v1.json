    {"cause_id": "missing_detection_model", "label_zh": "缺少检测模型"},
    {"cause_id": "missing_ocr_model", "label_zh": "缺少 OCR 模型"},
    {"cause_id": "missing_depth", "label_zh": "缺少深度感知"},
    {"cause_id": "missing_tracking", "label_zh": "缺少跟踪能力"},
    {"cause_id": "model_limitation", "label_zh": "模型能力限制"},
    {"cause_id": "annotation_incomplete", "label_zh": "标注不完整"},
    {"cause_id": "unknown", "label_zh": "原因未知"}
  ],
  "recommended_followup_models": [
