{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "schema_id": "local_test_asset_manifest_schema_v1",
  "title": "Local Test Asset Manifest V1",
  "description": "Scoped local test asset registered by Model Test Lens. Candidate-only, not runtime/fact source.",
  "type": "object",
  "required": [
    "manifest_id",
    "created_by_phase",
    "asset_id",
    "asset_type",
    "local_path",
    "file_name",
    "source_type",
    "scoped_for_model_test",
    "candidate_only",
    "must_not_enter_fact_layer",
    "must_not_enter_runtime",
    "protected"
  ],
  "properties": {
    "manifest_id": { "type": "string" },
    "created_by_phase": { "type": "string" },
    "asset_id": { "type": "string" },
    "asset_type": {
      "type": "string",
      "enum": ["image", "video", "frame_sequence", "audio", "text"]
    },
    "local_path": { "type": "string" },
    "file_name": { "type": "string" },
    "file_extension": { "type": "string" },
    "sha256": { "type": "string" },
    "file_size_bytes": { "type": "integer", "minimum": 0 },
    "media_metadata": { "type": "object" },
    "source_type": { "const": "user_supplied_local_asset" },
    "scoped_for_model_test": { "const": true },
    "allowed_models": { "type": "array", "items": { "type": "string" } },
    "intended_test_type": { "type": "string" },
    "candidate_only": { "const": true },
    "personal_sensitive_flag": { "type": "boolean" },
    "external_url_source": { "const": false },
    "live_camera_frame": { "const": false },
    "live_microphone_capture": { "const": false },
    "uncontrolled_dataset_source": { "const": false },
    "fact_layer_source": { "const": false },
    "semantic_layer_source": { "const": false },
    "navigation_runtime_frame": { "const": false },
    "must_not_enter_fact_layer": { "const": true },
    "must_not_enter_runtime": { "const": true },
    "must_not_enter_output_adapter": { "const": true },
    "must_not_enter_semantic_layer": { "const": true },
    "must_not_trigger_navigation_action_speech": { "const": true },
    "test_board_ref": { "type": "string" },
    "protected": { "const": true }
  }
}
