{
  "schema_id": "RealChainExecutionTraceV1",
  "version": "v1",
  "phase_ref": "Phase-P1-Midplatform-Luna-Model-Manager-Real-Multi-Model-Chain-Integration-Planning-v1-001",
  "description": "真实链路执行轨迹 — Slot → Fill → Runtime → Evidence",
  "required_fields": ["trace_id", "chain_id", "slot_executions", "candidate_only"],
  "properties": {
    "trace_id": {"type": "string"},
    "chain_id": {"type": "string"},
    "goal_type": {"type": "string"},
    "scene_type": {"type": "string"},
    "slot_executions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["slot_id", "capability", "provider_id", "output_type", "status"],
        "properties": {
          "slot_id": {"type": "string"},
          "capability": {"type": "string"},
          "provider_id": {"type": "string"},
          "output_type": {"type": "string"},
          "status": {"type": "string", "enum": ["pending", "completed", "failed", "skipped"]},
          "depends_on": {"type": "array"}
        }
      }
    },
    "candidate_only": {"type": "boolean", "const": true},
    "not_fact": {"type": "boolean", "const": true}
  }
}
