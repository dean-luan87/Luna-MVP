{
  "schema_id": "RealChainDryrunPolicyV1",
  "version": "v1",
  "phase_ref": "Phase-P1-Midplatform-Luna-Model-Manager-Real-Multi-Model-Chain-Integration-DryRun-v1-001",
  "layer_id": "Model_Manager_Real_Chain_DryRun",
  "dryrun_only": true,
  "principle": "验证编排逻辑，非模型效果 — deterministic runtime fixtures only",
  "chain": [
    "L1_Situation",
    "L2_Agent_Planning",
    "Collaboration_Plan_Candidate",
    "Slot_Binding",
    "Provider_Runtime_Candidate",
    "Evidence_Package",
    "Fusion_Candidate",
    "Decision_Validation",
    "Fact_Admission_Candidate"
  ],
  "rules": [
    {"rule_id": "slot_driven_not_pipeline", "description": "按 Slot 组织能力，非模型调用流水线"},
    {"rule_id": "deterministic_fixtures_only", "description": "不接真实 Detector/OCR/Qwen API"},
    {"rule_id": "fusion_not_fact", "description": "Fusion 产出 evidence package，非合并事实"},
    {"rule_id": "provider_upgrade_binding_only", "description": "Provider 升级仅改 binding，不改 L1/L2/Plan"},
    {"rule_id": "ocr_failure_no_qwen_guess", "description": "OCR 失败禁止 Qwen 猜字"},
    {"rule_id": "context_not_fact", "description": "Context 允许 candidate，禁止 fact"},
    {"rule_id": "conflict_no_confidence_override", "description": "冲突禁止 confidence 覆盖 OCR"},
    {"rule_id": "execution_trace_graph_required", "description": "完整 Execution Trace Graph"}
  ],
  "boundary_flags": {
    "dryrun_no_real_inference": true,
    "collaboration_slot_driven": true,
    "execution_trace_graph": true,
    "self_explainable": true,
    "no_auto_answer_fusion": true,
    "no_confidence_voting": true
  }
}
