{
  "schema_id": "DocumentSurfaceOptionBModelCandidateAdmissionPolicyV1",
  "version": "v1",
  "planning_only": true,
  "active_model_selection_allowed": false,
  "model_download_allowed": false,
  "training_allowed": false,
  "execution_allowed": false,
  "active_registry_update_allowed": false,
  "admission_status_values": [
    "pending_admission_review",
    "admitted_candidate_only",
