{
  "schema_id": "ModelBenchmarkRecordV1",
  "version": "v1",
  "phase_ref": "Phase-P1-Midplatform-Luna-Model-Manager-Lifecycle-Sandbox-v1-001",
  "description": "模型基准评估记录 — sandbox evaluation 产物",
  "required_fields": [
    "record_id",
    "model_id",
    "capability_id",
    "evaluation_status",
    "reliability",
    "latency_ms",
    "cost_tier",
    "candidate_only"
  ],
  "properties": {
    "record_id": {"type": "string"},
    "model_id": {"type": "string"},
    "capability_id": {"type": "string"},
    "evaluation_status": {
      "type": "string",
      "enum": ["passed", "failed", "inconclusive"]
    },
    "reliability": {"type": "number", "minimum": 0, "maximum": 1},
    "latency_ms": {"type": "number", "minimum": 0},
    "cost_tier": {"type": "string", "enum": ["low", "medium", "high"]},
    "unsupported_claim_rate": {"type": "number"},
    "scene_fit_scores": {"type": "object"},
    "routing_eligible_after_eval": {"type": "boolean"},
    "candidate_only": {"type": "boolean", "const": true},
    "not_fact": {"type": "boolean", "const": true}
  },
  "example": {
    "record_id": "mbr_vision_teacher_x_001",
    "model_id": "vision_teacher_x",
    "capability_id": "unknown_scene_reasoning",
    "evaluation_status": "passed",
    "reliability": 0.82,
    "latency_ms": 1200,
    "cost_tier": "medium",
    "routing_eligible_after_eval": true,
    "candidate_only": true,
    "not_fact": true
  }
}
