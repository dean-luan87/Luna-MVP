{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "luna.cognitive_primitive.v1",
  "title": "Luna Cognitive Primitive Layer Contract v1",
  "type": "object",
  "$defs": {
    "base": {
      "type": "object",
      "required": ["schema_version", "trace_ref", "provenance_refs", "candidate_only", "fact_admitted"],
      "properties": {
        "schema_version": {"const": "luna.cognitive_primitive.v1"},
        "trace_ref": {"type": "string", "minLength": 1},
        "provenance_refs": {"type": "array", "items": {"type": "string"}},
        "candidate_only": {"const": true},
        "fact_admitted": {"const": false}
      }
    },
    "observation": {
      "allOf": [
        {"$ref": "#/$defs/base"},
        {"type": "object", "required": ["observation_id", "source_ref", "observation_type", "occurred_at", "observed_at", "payload", "evidence_refs"], "properties": {
          "observation_id": {"type": "string", "minLength": 1},
          "source_ref": {"type": "string", "minLength": 1},
          "observation_type": {"type": "string", "minLength": 1},
          "occurred_at": {"type": "string", "minLength": 1},
          "observed_at": {"type": "string", "minLength": 1},
          "payload": {"type": "object"},
          "evidence_refs": {"type": "array", "items": {"type": "string"}},
          "conclusion_made": {"const": false}
        }}
      ]
    },
    "evidence": {
      "allOf": [
        {"$ref": "#/$defs/base"},
        {"type": "object", "required": ["evidence_id", "source_type", "source_ref", "content_ref", "confidence", "created_at"], "properties": {
          "evidence_id": {"type": "string", "minLength": 1},
          "source_type": {"enum": ["sensor", "model", "user", "knowledge", "experience", "simulation"]},
          "source_ref": {"type": "string", "minLength": 1},
          "content_ref": {"type": "string", "minLength": 1},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "created_at": {"type": "string", "minLength": 1}
        }}
      ]
    },
    "entity_candidate": {
      "allOf": [
        {"$ref": "#/$defs/base"},
        {"type": "object", "required": ["entity_id", "entity_type", "attributes", "evidence_refs", "observation_refs"], "properties": {
          "entity_id": {"type": "string", "minLength": 1},
          "entity_type": {"type": "string", "minLength": 1},
          "attributes": {"type": "object"},
          "evidence_refs": {"type": "array", "items": {"type": "string"}},
          "observation_refs": {"type": "array", "items": {"type": "string"}}
        }}
      ]
    },
    "relation_candidate": {
      "allOf": [
        {"$ref": "#/$defs/base"},
        {"type": "object", "required": ["relation_id", "subject_ref", "predicate", "object_ref", "evidence_refs"], "properties": {
          "relation_id": {"type": "string", "minLength": 1},
          "subject_ref": {"type": "string", "minLength": 1},
          "predicate": {"type": "string", "minLength": 1},
          "object_ref": {"type": "string", "minLength": 1},
          "evidence_refs": {"type": "array", "items": {"type": "string"}}
        }}
      ]
    },
    "field_reference_candidate": {
      "allOf": [
        {"$ref": "#/$defs/base"},
        {"type": "object", "required": ["field_ref", "field_type_candidate", "relation_context", "evidence_refs"], "properties": {
          "field_ref": {"type": "string", "minLength": 1},
          "field_type_candidate": {"type": "string", "minLength": 1},
          "relation_context": {"type": "object"},
          "evidence_refs": {"type": "array", "items": {"type": "string"}}
        }}
      ]
    },
    "state_candidate": {
      "allOf": [
        {"$ref": "#/$defs/base"},
        {"type": "object", "required": ["state_id", "target_ref", "state_type", "value", "evidence_refs", "temporal_context", "field_state_modified"], "properties": {
          "state_id": {"type": "string", "minLength": 1},
          "target_ref": {"type": "string", "minLength": 1},
          "state_type": {"type": "string", "minLength": 1},
          "value": {"type": "object"},
          "evidence_refs": {"type": "array", "items": {"type": "string"}},
          "temporal_context": {"type": "object"},
          "field_state_modified": {"const": false}
        }}
      ]
    }
  },
  "properties": {
    "observation": {"$ref": "#/$defs/observation"},
    "evidence": {"$ref": "#/$defs/evidence"},
    "entity_candidate": {"$ref": "#/$defs/entity_candidate"},
    "relation_candidate": {"$ref": "#/$defs/relation_candidate"},
    "field_reference_candidate": {"$ref": "#/$defs/field_reference_candidate"},
    "state_candidate": {"$ref": "#/$defs/state_candidate"}
  },
  "boundary": {
    "observation_is_not_fact": true,
    "evidence_is_not_conclusion": true,
    "entity_is_not_understanding": true,
    "state_candidate_is_not_field_state": true,
    "hypothesis_is_not_decision": true,
    "field_state_mutation_allowed": false,
    "decision_allowed": false
  }
}
