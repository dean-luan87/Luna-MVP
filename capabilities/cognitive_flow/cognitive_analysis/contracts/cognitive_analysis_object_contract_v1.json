    "AnalysisEvidenceAssessmentV1": ["assessment_id", "assessment_version", "evidence_ref", "hypothesis_ref", "relation", "strength_candidate", "reliability_candidate", "temporal_relevance", "scope_relevance", "uncertainty", "lifecycle_status", "provenance", "trace_ref"],
    "InformationGapRefinementV1": ["refinement_id", "source_analysis_frame_ref", "gap_type", "refined_question", "required_information_type", "target_field_refs", "target_relation_refs", "priority_candidate", "blocking_level", "recommended_observation_scope", "resolution_criteria", "lifecycle_status", "provenance", "trace_ref"],
