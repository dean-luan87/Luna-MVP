    "AnalysisEvidenceAssessmentV1",
    "InformationGapRefinementV1",
    "ObservationRequestCandidateV1",
    "CognitiveAnalysisSufficiencyResultV1",
    "CognitiveAnalysisResultV1"
  ],
  "required_fields": {
    "CognitiveAnalysisAdmissionResultV1": ["admission_id", "source_context_ref", "source_context_version", "status", "reason_codes", "blocking_gap_refs", "warning_codes", "permission_allowed", "provenance_complete", "trace_complete", "source_snapshot_traceable", "lifecycle_status", "provenance", "trace_ref"],
