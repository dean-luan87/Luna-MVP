{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "luna.capability_module_manifest.schema.v1",
    "title": "Luna Capability Module Manifest Schema v1",
    "type": "object",
    "required": [
        "capability_id",
        "capability_name",
        "domain",
        "owner_layer",
        "responsibility",
        "lifecycle_status",
        "module_version",
        "api_version",
        "input_contract",
        "output_contract",
        "dependencies",
        "dependents",
        "module_api",
        "implementation_path",
        "integration_runner",
        "diagnostics_support",
        "trace_support",
        "replay_support",
        "persistence_authority",
        "fact_admission_authority",
        "action_execution_authority",
        "runtime_authority",
        "replacement_policy",
        "upgrade_policy",
        "deprecation_policy",
        "known_limitations",
        "ready_evidence",
        "last_updated"
    ],
    "properties": {
        "capability_id": {
            "type": "string",
            "pattern": "^luna\\.[a-z0-9_]+$"
        },
        "capability_name": {
            "type": "string",
            "minLength": 1
        },
        "domain": {
            "type": "string",
            "minLength": 1
        },
        "owner_layer": {
            "type": "string",
            "minLength": 1
        },
        "responsibility": {
            "type": "string",
            "minLength": 1
        },
        "lifecycle_status": {
            "type": "string",
            "enum": [
                "planned",
                "skeleton_ready",
                "building",
                "integration_ready",
                "functional_module_ready",
                "degraded",
                "blocked",
                "deprecated",
                "retired"
            ]
        },
        "module_version": {
            "type": "string",
            "pattern": "^v[0-9]+$"
        },
        "api_version": {
            "type": "string",
            "pattern": "^v[0-9]+$"
        },
        "input_contract": {
            "type": "object",
            "required": [
                "summary",
                "refs"
            ],
            "properties": {
                "summary": {
                    "type": "string"
                },
                "refs": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            }
        },
        "output_contract": {
            "type": "object",
            "required": [
                "summary",
                "refs"
            ],
            "properties": {
                "summary": {
                    "type": "string"
                },
                "refs": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            }
        },
        "dependencies": {
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "dependents": {
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "module_api": {
            "type": "object",
            "required": [
                "path",
                "exists"
            ],
            "properties": {
                "path": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "exists": {
                    "type": "boolean"
                }
            }
        },
        "implementation_path": {
            "type": [
                "string",
                "null"
            ]
        },
        "integration_runner": {
            "type": "object",
            "required": [
                "path",
                "exists",
                "runner_type"
            ],
            "properties": {
                "path": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "exists": {
                    "type": "boolean"
                },
                "runner_type": {
                    "type": "string",
                    "enum": [
                        "module_integration",
                        "controlled_dryrun",
                        "smoke",
                        "planning",
                        "none"
                    ]
                }
            }
        },
        "diagnostics_support": {
            "type": "object",
            "required": [
                "supported",
                "refs"
            ],
            "properties": {
                "supported": {
                    "type": "boolean"
                },
                "refs": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            }
        },
        "trace_support": {
            "type": "object",
            "required": [
                "supported",
                "refs"
            ],
            "properties": {
                "supported": {
                    "type": "boolean"
                },
                "refs": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            }
        },
        "replay_support": {
            "type": "object",
            "required": [
                "supported",
                "refs"
            ],
            "properties": {
                "supported": {
                    "type": "boolean"
                },
                "refs": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            }
        },
        "persistence_authority": {
            "type": "boolean"
        },
        "fact_admission_authority": {
            "type": "boolean"
        },
        "action_execution_authority": {
            "type": "boolean"
        },
        "runtime_authority": {
            "type": "boolean"
        },
        "replacement_policy": {
            "type": "string",
            "enum": [
                "planned_replacement",
                "governed_hot_swap",
                "manual_only"
            ]
        },
        "upgrade_policy": {
            "type": "string",
            "enum": [
                "evidence_gated",
                "semver_controlled",
                "manual_only"
            ]
        },
        "deprecation_policy": {
            "type": "string",
            "enum": [
                "announce_and_freeze_dependents",
                "compat_read_only_then_retire",
                "manual_only"
            ]
        },
        "known_limitations": {
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "ready_evidence": {
            "type": [
                "object",
                "null"
            ],
            "properties": {
                "total_cases": {
                    "type": "integer"
                },
                "passed_cases": {
                    "type": "integer"
                },
                "failed_cases": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "deterministic_replay": {
                    "type": "boolean"
                },
                "trace_present_all": {
                    "type": "boolean"
                },
                "replay_present_all": {
                    "type": "boolean"
                },
                "boundary_preserved": {
                    "type": "boolean"
                },
                "evidence_ref": {
                    "type": "string"
                }
            },
            "required": []
        },
        "internal_components": {
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "manifest_path": {
            "type": [
                "string",
                "null"
            ]
        },
        "last_updated": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        }
    },
    "additionalProperties": false
}