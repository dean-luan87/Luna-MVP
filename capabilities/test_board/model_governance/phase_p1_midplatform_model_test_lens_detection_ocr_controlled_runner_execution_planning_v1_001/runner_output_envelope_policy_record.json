{
  "phase_id": "Phase-P1-Midplatform-Model-Test-Lens-Detection-OCR-Controlled-Runner-Execution-Planning-v1-001",
  "protected": true,
  "non_deletable": true,
  "deletion_forbidden": true,
  "test_artifact_protected": true,
  "test_mode": "planning",
  "planning_only": true,
  "record": {
    "schema_id": "RunnerOutputEnvelopePolicyV1",
    "version": "v1",
    "phase_ref": "Phase-P1-Midplatform-Model-Test-Lens-Detection-OCR-Controlled-Runner-Execution-Planning-v1-001",
    "description": "Runner 输出 envelope 规划。输出是 result candidate，必须经 fact admission 才能写 fact。",
    "planning_only": true,
    "no_real_output_in_planning_phase": true,
    "runner_output_not_fact": true,
    "fact_admission_required_before_fact_write": true,
    "detection_output_envelope": {
      "envelope_type": "detection_result_candidate",
      "required_fields": [
        "object_detection_candidate",
        "confidence",
        "bbox_or_mask_ref",
        "region_relation",
        "source_runner_execution_id",
        "source_execution_candidate_id",
        "not_fact",
        "needs_fact_admission"
      ],
      "forbidden_fields": [
        "fact_label",
        "navigation_decision",
        "confirmed_dynamic"
      ]
    },
    "ocr_output_envelope": {
      "envelope_type": "ocr_result_candidate",
      "required_fields": [
        "ocr_text_candidate",
        "text_region_candidate",
        "confidence",
        "reading_order_candidate",
        "source_runner_execution_id",
        "source_execution_candidate_id",
        "not_fact",
        "needs_fact_admission"
      ],
      "forbidden_fields": [
        "fact_text",
        "navigation_decision",
        "confirmed_reading"
      ]
    },
    "forbidden_operations": [
      "runner_output_direct_to_fact",
      "runner_output_to_navigation",
      "overwrite_observation_attention_record",
      "overwrite_segmentation_label",
      "skip_fact_admission"
    ],
    "visual_expression_rules": {
      "no_execution_box_on_canvas": true,
      "result_layer_owner": "right_panel_result_candidate_zone",
      "must_not_override_segmentation_boundary": true
    },
    "boundary_flags": {
      "runner_output_requires_envelope": true,
      "runner_output_requires_fact_admission_before_fact_write": true,
      "not_fact": true,
      "planning_only": true
    }
  }
}
