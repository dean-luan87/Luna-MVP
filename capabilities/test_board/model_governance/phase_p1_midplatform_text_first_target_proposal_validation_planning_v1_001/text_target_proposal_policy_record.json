    "description": "Text-first target proposal 总策略：文字场景以 text detector 为主入口，SAM 为 region proposal 辅链。",
    "planning_only": true,
    "principle": "文字场景：text detector first；对象场景：grounding/detection；结构场景：SAM/Depth/SLAM。",
    "candidate_layers": {
      "region_proposal_candidate": {
        "source": [
          "mobile_sam",
          "sam_refine"
        ],
        "role": "spatial_region_proposal",
        "not_primary_for_text_discovery": true
      },
      "text_region_candidate": {
        "source": [
          "text_detector_stub",
          "ocr_text_detector"
        ],
        "role": "text_area_proposal",
        "primary_for_text_scenes": true
      },
      "semantic_target_candidate": {
        "source": [
          "grounding",
          "detection",
          "vlm_route"
        ],
        "role": "object_or_attention_target"
      }
    },
    "text_first_chain": [
      "input_image",
      "text_detector_stub",
      "text_region_candidate",
      "midplatform_target_selection",
      "target_proposal_comparison_candidate",
      "ocr_task_candidate"
    ],
    "sam_role": {
