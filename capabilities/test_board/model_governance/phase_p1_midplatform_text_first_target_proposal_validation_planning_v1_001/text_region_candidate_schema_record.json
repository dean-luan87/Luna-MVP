{
  "phase_id": "Phase-P1-Midplatform-Text-First-Target-Proposal-Validation-Planning-v1-001",
  "protected": true,
  "non_deletable": true,
  "deletion_forbidden": true,
  "test_artifact_protected": true,
  "test_mode": "planning",
  "text_first_target_proposal_planning": true,
  "record": {
    "schema_id": "TextRegionCandidateSchemaV1",
    "version": "v1",
    "phase_ref": "Phase-P1-Midplatform-Text-First-Target-Proposal-Validation-Planning-v1-001",
    "description": "OCR text detector 输出的文字区域候选。不是 OCR result，不是 fact。",
    "planning_only": true,
    "candidate_only": true,
    "not_fact": true,
    "required_fields": [
      "candidate_id",
      "source_image_ref",
      "candidate_type",
      "bbox",
      "confidence",
      "candidate_only",
      "not_fact",
      "trace_chain"
    ],
    "candidate_type_enum": [
      "text_region_candidate",
      "text_line_candidate",
      "text_block_candidate"
    ],
    "field_definitions": {
      "candidate_id": {
        "type": "string"
      },
      "source_image_ref": {
        "type": "string"
      },
      "candidate_type": {
        "type": "string",
        "enum": [
          "text_region_candidate",
          "text_line_candidate",
          "text_block_candidate"
        ]
      },
      "bbox": {
        "type": "object",
        "properties": {
          "x1": {
            "type": "number"
          },
          "y1": {
            "type": "number"
          },
          "x2": {
            "type": "number"
          },
          "y2": {
            "type": "number"
          }
        }
      },
      "confidence": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      },
      "text_likelihood": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      },
      "scene_hint": {
        "type": "string",
        "description": "e.g. subway_direction_sign, shop_sign_main_text — not fact label"
      },
      "source_model": {
        "type": "string",
        "enum": [
          "text_detector_stub_v1",
          "ocr_text_detector_placeholder"
        ]
      },
      "recognized_text": {
        "type": "null",
        "description": "Planning: must be null — no OCR recognition in this phase"
      },
      "candidate_only": {
        "type": "boolean",
        "const": true
      },
      "not_fact": {
        "type": "boolean",
        "const": true
      },
      "text_region_candidate_not_fact": {
        "type": "boolean",
        "const": true
      },
      "trace_chain": {
        "type": "array"
      }
    },
    "forbidden_operations": [
      "recognized_text_as_fact",
      "text_region_as_ocr_result",
      "text_region_direct_navigation",
      "text_region_skip_midplatform"
    ],
    "boundary_flags": {
      "text_region_candidate_not_fact": true,
      "no_ocr_recognition": true,
      "text_detector_stub_not_ocr_result": true,
      "no_fact_write": true,
      "planning_only": true
    }
  }
}
