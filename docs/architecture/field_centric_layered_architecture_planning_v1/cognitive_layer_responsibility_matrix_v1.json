{
    "layers": [
        {
            "layer_id": "L0",
            "layer_name": "Observation Scan",
            "purpose": "Collect raw observations and boundary signals",
            "input_owner": "observation_channel",
            "output_owner": "observation_candidate",
            "interpretation_owner": "observation_scan",
            "allowed_candidate_types": [
                "observation_candidate"
            ],
            "prohibited_outputs": [
                "fact",
                "runtime_activation"
            ],
            "required_governance_refs": [
                "runtime_boundary",
                "evidence_chain"
            ],
            "required_verifier_classes": [
                "boundary_verifier"
            ],
            "stop_condition": "insufficient_signal_quality"
        },
        {
            "layer_id": "L1",
            "layer_name": "Field Understanding",
            "purpose": "Construct a minimal field representation",
            "input_owner": "observation_scan",
            "output_owner": "field_candidate",
            "interpretation_owner": "field_understanding",
            "allowed_candidate_types": [
                "field_candidate"
            ],
            "prohibited_outputs": [
                "production_action",
                "full_world_reconstruction"
            ],
            "required_governance_refs": [
                "candidate_fact_admission",
                "evidence_chain"
            ],
            "required_verifier_classes": [
                "candidate_verifier"
            ],
            "stop_condition": "no_stable_field_candidate"
        },
        {
            "layer_id": "L2",
            "layer_name": "Situation and Goal",
            "purpose": "Frame current situation and goal state",
            "input_owner": "field_understanding",
            "output_owner": "situation_goal_candidate",
            "interpretation_owner": "situation_goal",
            "allowed_candidate_types": [
                "situation_goal_candidate"
            ],
            "prohibited_outputs": [
                "policy_override",
                "hidden_state_injection"
            ],
            "required_governance_refs": [
                "candidate_fact_admission",
                "negative_guards"
            ],
            "required_verifier_classes": [
                "governance_verifier"
            ],
            "stop_condition": "incomplete_situation_context"
        },
        {
            "layer_id": "L3",
            "layer_name": "Expectation Generation",
            "purpose": "Generate expectation candidates",
            "input_owner": "situation_goal",
            "output_owner": "expectation_candidate",
            "interpretation_owner": "expectation",
            "allowed_candidate_types": [
                "expectation_candidate"
            ],
            "prohibited_outputs": [
                "fact_promotion",
                "runtime_override"
            ],
            "required_governance_refs": [
                "candidate_fact_admission",
                "evidence_chain"
            ],
            "required_verifier_classes": [
                "candidate_verifier"
            ],
            "stop_condition": "no_expectation_candidate"
        },
        {
            "layer_id": "L4",
            "layer_name": "Attention Allocation",
            "purpose": "Focus attention on relevant cues",
            "input_owner": "expectation",
            "output_owner": "attention_candidate",
            "interpretation_owner": "attention",
            "allowed_candidate_types": [
                "attention_candidate"
            ],
            "prohibited_outputs": [
                "autonomous_action",
                "over_commitment"
            ],
            "required_governance_refs": [
                "runtime_boundary",
                "negative_guards"
            ],
            "required_verifier_classes": [
                "boundary_verifier"
            ],
            "stop_condition": "attention_ambiguous"
        },
        {
            "layer_id": "L5",
            "layer_name": "Region Intelligence",
            "purpose": "Generate region-level evidence candidates",
            "input_owner": "attention",
            "output_owner": "region_evidence_candidate",
            "interpretation_owner": "region_intelligence",
            "allowed_candidate_types": [
                "region_evidence_candidate"
            ],
            "prohibited_outputs": [
                "production_execution",
                "full_world_reconstruction"
            ],
