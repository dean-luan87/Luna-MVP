                "evidence_chain"
            ],
            "required_verifier_classes": [
                "evidence_verifier"
            ],
            "stop_condition": "insufficient_region_evidence"
        },
        {
            "layer_id": "L6",
            "layer_name": "Role and Relation Inference",
            "purpose": "Infer role and relation candidates",
            "input_owner": "region_intelligence",
            "output_owner": "role_candidate",
            "interpretation_owner": "role_relation_inference",
            "allowed_candidate_types": [
                "role_candidate",
                "relation_candidate"
            ],
            "prohibited_outputs": [
                "irreversible_intervention",
                "fact_promotion"
            ],
            "required_governance_refs": [
                "candidate_fact_admission",
                "evidence_chain"
            ],
            "required_verifier_classes": [
                "candidate_verifier"
            ],
            "stop_condition": "role_hypothesis_unresolved"
        },
        {
            "layer_id": "L7",
            "layer_name": "Evidence Fusion",
            "purpose": "Merge evidence candidates into a coherent state",
            "input_owner": "role_relation_inference",
            "output_owner": "evidence_candidate",
            "interpretation_owner": "evidence_fusion",
            "allowed_candidate_types": [
                "evidence_candidate"
            ],
            "prohibited_outputs": [
                "fact_promotion_without_admission"
            ],
            "required_governance_refs": [
                "candidate_fact_admission",
                "evidence_chain"
            ],
            "required_verifier_classes": [
                "evidence_verifier"
            ],
            "stop_condition": "evidence_incoherent"
        },
        {
            "layer_id": "L8",
            "layer_name": "Decision and Interaction",
            "purpose": "Decide whether and how to interact",
            "input_owner": "evidence_fusion",
            "output_owner": "interaction_decision_candidate",
            "interpretation_owner": "decision",
            "allowed_candidate_types": [
                "interaction_decision_candidate"
            ],
            "prohibited_outputs": [
                "autonomous_irreversible_action"
            ],
            "required_governance_refs": [
                "runtime_boundary",
                "negative_guards"
            ],
            "required_verifier_classes": [
                "interaction_verifier"
            ],
            "stop_condition": "interaction_decision_unresolved"
        },
        {
            "layer_id": "L9",
            "layer_name": "Feedback and Memory",
            "purpose": "Record feedback and memory candidates",
            "input_owner": "decision",
            "output_owner": "feedback_candidate",
            "interpretation_owner": "feedback_memory",
            "allowed_candidate_types": [
                "feedback_candidate",
                "memory_candidate"
            ],
            "prohibited_outputs": [
                "implicit_fact_promotion"
            ],
            "required_governance_refs": [
                "evidence_chain",
                "rollback_revocation"
            ],
            "required_verifier_classes": [
                "memory_verifier"
            ],
            "stop_condition": "no_durable_memory_candidate"
        }
    ]
}