  "scan_contract": {
    "every_cognitive_directory_receives_status": true,
    "historical_assets_are_not_deleted": true,
    "missing_assets_are_registered_only": true,
    "inventory_is_not_runtime_input": true,
    "rescan_required_after_asset_change": true,
    "unknowns_are_preserved": true,
    "provenance_is_preserved": true
  }
