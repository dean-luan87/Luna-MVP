{
  "title": "Architecture Asset Inventory v1",
  "inventory_scope": "docs/architecture/",
  "inventory_mode": "policy plus repository snapshot",
  "status_values": ["active", "historical", "verification_only", "missing_asset_candidate"],
  "required_asset_types": ["md", "json", "verifier"],
