    {"category": "Category B", "status": "historical", "required": ["status metadata", "provenance"], "deletion_allowed": false},
    {"category": "Category C", "status": "verification_only", "required": ["verifier", "scope note"], "deletion_allowed": false},
    {"category": "Category D", "status": "missing_asset_candidate", "required": ["inventory entry", "remediation decision"], "deletion_allowed": false}
