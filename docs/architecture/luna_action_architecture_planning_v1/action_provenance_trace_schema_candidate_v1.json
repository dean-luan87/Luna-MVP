{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "luna://planning/action/provenance-trace/v1",
    "title": "Action Provenance Trace Schema Candidate v1",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "action_candidate_id",
        "owner",
        "trace"
    ],
    "properties": {
        "action_candidate_id": {
            "type": "string"
        },
        "owner": {
            "const": "Action Governance"
        },
        "trace": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "object",
                "required": [
                    "kind",
                    "owner",
                    "ref_id"
                ],
                "properties": {
                    "kind": {
                        "type": "string",
                        "enum": [
                            "decision",
                            "intent",
                            "causal",
                            "target",
                            "context",
                            "field",
                            "permission",
                            "safety",
                            "confirmation",
                            "precondition",
                            "dependency",
                            "resource",
                            "risk",
                            "runtime_feedback",
                            "task_reference"
                        ]
                    },
                    "owner": {
                        "type": "string"
                    },
                    "ref_id": {
                        "type": "string"
                    },
                    "note": {
                        "type": "string"
                    }
                },
                "additionalProperties": true
            }
        }
    }
}