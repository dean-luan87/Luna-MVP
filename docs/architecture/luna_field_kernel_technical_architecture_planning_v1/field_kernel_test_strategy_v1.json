{
    "tests": [
        {
            "test_id": "reducer_determinism_test",
            "objective": "验证相同事件序列产生相同 FieldState 归约结果。",
            "fixture_requirements": [
                "event sequence fixture",
                "initial FieldState"
            ],
            "expected_outputs": [
                "deterministic_reduced_state"
            ],
            "negative_guards": [
                "non-deterministic reducer path"
            ],
            "deterministic_required": true,
            "real_model_required": false,
            "image_read_required": false,
            "runtime_required": false
        },
        {
            "test_id": "event_replay_test",
            "objective": "验证事件回放能恢复当前 FieldState。",
            "fixture_requirements": [
                "event timeline fixture",
                "snapshot reference"
            ],
            "expected_outputs": [
                "replayed_field_state"
            ],
            "negative_guards": [
                "direct state mutation bypass"
            ],
            "deterministic_required": true,
            "real_model_required": false,
            "image_read_required": false,
            "runtime_required": false
        },
        {
            "test_id": "temporal_expiry_test",
            "objective": "验证 temporal definition 到期后进入 expired_state。",
            "fixture_requirements": [
                "temporal definition fixture",
                "expiry timestamp"
            ],
            "expected_outputs": [
                "expired_state marker"
            ],
            "negative_guards": [
                "expired definition remains active"
            ],
            "deterministic_required": true,
            "real_model_required": false,
            "image_read_required": false,
            "runtime_required": false
        },
        {
            "test_id": "multi_reality_coexistence_test",
