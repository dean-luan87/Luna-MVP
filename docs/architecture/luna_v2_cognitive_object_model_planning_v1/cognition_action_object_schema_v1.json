    "rules": [
        "ExpectationCandidate may not become fact",
        "AttentionCandidate only decides resource and observation target",
        "InteractionDecisionCandidate does not equal action execution",
        "PersonalityDevelopmentCandidate may not automatically modify production personality",
        "FeedbackCandidate may only form corrective candidates",
        "CognitiveRevision must retain old version and reason"
    ]
