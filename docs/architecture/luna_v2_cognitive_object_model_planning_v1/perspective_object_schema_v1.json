                "Safety Overrides Perspective",
                "Evidence Chain"
            ],
            "candidate_only": true,
            "not_fact": true
        },
        "PerspectiveSelectionCandidate": {
            "object_type": "decision_candidate",
            "parent_type": "decision_candidate",
            "required_fields": [
                "object_id",
                "object_type",
                "schema_version",
                "lifecycle_status",
                "owner_scope",
                "source_scope",
                "perspective_scope",
                "field_scope",
                "temporal_validity",
                "confidence",
                "candidate_only",
                "not_fact",
                "created_at",
                "updated_at",
                "revision",
                "revoked",
                "unresolved_fields",
                "selected_perspective_ref",
                "selection_reason",
