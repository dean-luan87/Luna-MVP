{
    "schema_id": "perspective_object_schema_v1",
    "schema_version": "1.0.0",
    "description": "Perspective object schemas for Luna V2.",
    "objects": {
        "PerspectiveDefinition": {
            "object_type": "entity",
            "parent_type": "entity",
            "required_fields": [
                "object_id",
                "object_type",
                "schema_version",
                "lifecycle_status",
                "owner_scope",
                "source_scope",
                "perspective_scope",
                "field_scope",
                "temporal_validity",
                "confidence",
                "candidate_only",
                "not_fact",
                "created_at",
                "updated_at",
                "revision",
                "revoked",
                "unresolved_fields",
                "perspective_category",
                "applicability_scope",
                "mandatory_safety_constraint"
            ],
            "optional_fields": [
                "evidence_refs",
                "trace_refs",
                "governance_refs",
                "primary_perspective",
                "secondary_perspectives",
                "perspective_weights",
                "suppressed_perspectives",
                "perspective_conflicts",
                "selection_reason",
                "task_ref",
                "emotion_modulation_ref",
                "personality_preference_ref",
                "extension_data"
            ],
            "allowed_relations": [
                "conflicts_with",
                "supported_by",
                "perceived_by",
                "meaningful_to"
            ],
            "prohibited_outputs": [
                "safety_override_without_governance"
            ],
            "lifecycle_rules": [
                "proposed -> admitted_candidate -> active_candidate"
            ],
            "governance_refs": [
