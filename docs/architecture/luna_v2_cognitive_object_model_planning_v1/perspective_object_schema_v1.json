                "object_type",
                "schema_version",
                "lifecycle_status",
                "owner_scope",
                "source_scope",
                "perspective_scope",
                "field_scope",
                "temporal_validity",
                "confidence",
                "candidate_only",
                "not_fact",
                "created_at",
                "updated_at",
                "revision",
                "revoked",
                "unresolved_fields",
