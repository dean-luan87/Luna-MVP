        "PerspectiveConflict": {
            "object_type": "relation",
            "parent_type": "relation",
            "required_fields": [
                "object_id",
                "object_type",
                "schema_version",
                "lifecycle_status",
                "owner_scope",
                "source_scope",
                "perspective_scope",
                "field_scope",
                "temporal_validity",
                "confidence",
