            ],
            "lifecycle_rules": [
                "proposed -> admitted_candidate -> active_candidate"
            ],
            "governance_refs": [
                "Candidate / Fact Admission",
                "Safety Overrides Perspective"
            ],
            "candidate_only": true,
            "not_fact": true
        }
    },
    "perspective_categories": [
        "safety",
        "navigation",
        "food_search",
        "social_living",
        "personal_memory",
        "exploration",
        "learning",
        "commercial",
        "healthcare",
        "emergency"
    ],
    "rules": [
        "primary_perspective is unique",
        "secondary_perspectives can be multiple",
        "safety is mandatory and non-overridable",
        "perspective selection only changes interpretation weight, not physical reality",
        "emotion may modulate perspective but cannot override safety"
    ]
}