{
  "artifact": "personality_evidence_admission_model_v1",
  "admission_states": ["PROPOSED", "EVIDENCE_ACCUMULATING", "ELIGIBLE", "INSUFFICIENT_EVIDENCE", "CONTESTED", "NEEDS_CONFIRMATION", "ADMITTED_CANDIDATE", "REVISED", "SUPERSEDED", "REVOKED", "EXPIRED", "REJECTED"],
  "evaluation_axes": ["source_scope", "evidence_strength", "repetition", "context_diversity", "temporal_span", "uncertainty", "contradiction", "counterexample", "user_correction", "sensitivity", "provenance_completeness", "owner_authority"],
  "admission_rules": {
    "one_event_is_insufficient": true,
    "same_context_repetition_is_not_global_proof": true,
    "cross_context_requires_stricter_evidence": true,
    "cross_time_requires_temporal_span": true,
    "source_owner_semantics_remain_immutable": true,
    "contradiction_prevents_silent_averaging": true,
    "counterexample_can_lower_or_block_stability": true,
    "explicit_user_correction_precedes_inference": true,
    "profile_may_hold_multiple_candidates": true,
    "admission_does_not_activate_trait": true
  },
  "required_candidate_metadata": ["source_refs", "evidence_refs", "uncertainty_refs", "contradiction_refs", "counterexample_refs", "trace_ref", "provenance_refs", "sensitivity"],
  "decision_outputs": ["trait_candidate", "profile_candidate", "revision_candidate", "revocation_candidate", "supersession_candidate", "expiration_candidate", "deferred_candidate"],
  "user_correction_rule": "A user correction creates a high-precedence evidence/revision candidate; it cannot be silently merged into inferred evidence."
}
