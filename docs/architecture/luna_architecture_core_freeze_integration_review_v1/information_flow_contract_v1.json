    {"from":"Expectation","to":"Decision","object":"Brain Input Package","owner":"Brain"},
    {"from":"Decision","to":"Action","object":"Action Request Candidate","owner":"Action Boundary"},
    {"from":"Action","to":"Outcome","object":"Outcome Evidence","owner":"Action Runtime"},
    {"from":"Outcome","to":"Learning","object":"Learning Signal","owner":"Learning System"},
    {"from":"Learning","to":"Evolution","object":"Growth Candidate","owner":"Self Evolution"}
