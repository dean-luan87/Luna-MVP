  "states":["COMPARABLE","PARTIALLY_COMPARABLE","NOT_COMPARABLE","INSUFFICIENT_EVIDENCE","STALE_ACTUAL","STALE_EXPECTATION","CONTESTED","NEEDS_CONFIRMATION"],
  "checks":["same target/entity","same attribute/relation","compatible temporal window","compatible spatial scope","compatible units/schema","sufficient evidence","contradiction state","uncertainty","source validity","correction/revocation status"],
