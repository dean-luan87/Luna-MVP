  "field_projection": {
    "type": "object",
    "source_owner": "Field State System",
    "read_only": true
  },
  "self_projection": {
    "type": "object",
    "source_owner": "Self System",
    "read_only": true
  },
  "role_projection": {
    "type": "object",
    "source_owner": "Role System / Social Self",
    "read_only": true
  },
  "relationship_projection": {
    "type": "object",
    "source_owner": "Relationship System / Social Self",
    "read_only": true
  },
  "memory_projection": {
    "type": "object",
    "source_owner": "Memory System",
    "read_only": true
  },
  "emotion_projection": {
    "type": "object",
    "source_owner": "Emotion Context Boundary / Integration Layer",
    "read_only": true,
    "calculation_allowed": false
