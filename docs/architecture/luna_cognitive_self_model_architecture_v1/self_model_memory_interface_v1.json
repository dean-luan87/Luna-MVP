{
  "title": "Self Model Memory Interface v1",
  "owner": "Memory System",
  "inputs": ["Current Task", "Current Context", "Attention Query", "Self History Request"],
  "outputs": ["Relevant Self History Reference", "Capability History Reference", "State Transition Reference"],
