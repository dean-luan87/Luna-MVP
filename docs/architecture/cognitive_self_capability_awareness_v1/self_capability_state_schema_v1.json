{
  "title": "Self Capability State Schema v1",
  "type": "object",
  "required": [
    "identity",
    "capability_states",
    "resource_context",
    "limitations",
    "health_context",
    "confidence_context",
    "provenance"
  ],
  "properties": {
    "identity": {
      "type": "object",
      "description": "Stable Luna Identity; not rewritten by capability change"
    },
    "capability_states": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["capability_id", "state", "confidence"]
      }
    },
    "resource_context": {"type": "object"},
    "limitations": {"type": "array"},
    "health_context": {"type": "object"},
    "confidence_context": {"type": "object"},
    "provenance": {"type": "array"},
    "unknowns": {"type": "array"}
  },
  "state_values": ["Available", "Degraded", "Limited", "Unavailable", "Unknown"],
  "boundary": {
    "identity_is_stable": true,
    "capability_is_dynamic": true,
    "experience_is_reference_only": true,
    "personality_is_out_of_scope": true,
    "self_state_is_not_reality": true,
    "reducer_is_sole_state_mutation_authority": true,
    "does_not_modify_goal": true,
    "does_not_modify_decision": true,
    "does_not_modify_action": true,
    "does_not_modify_reality": true
  }
}
