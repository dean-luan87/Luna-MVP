{
  "version":"1.0",
  "name":"Knowledge Admission Contract",
  "owner":"Knowledge Library Governance",
  "pipeline":["External Knowledge Candidate","Source and Provenance Review","Scope and Permission Review","Evidence/Limitations Review","Admission Candidate","Local Knowledge Boundary"],
