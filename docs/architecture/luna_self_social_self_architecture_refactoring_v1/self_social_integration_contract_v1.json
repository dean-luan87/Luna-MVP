{
  "version": "1.0",
  "name": "Self Social Integration Contract",
  "owner": "Cognitive Integration Layer",
  "inputs": ["Self State", "Self Capability", "Social State", "Role Context", "Relationship Context", "Field Context", "Memory Context", "Constitution Constraints"],
  "flow": ["Self State", "Social State", "Integration Assessment", "Context Package", "Brain Review", "Possible Candidate Update"],
