  "cannot": ["Direct Self Mutation", "Direct Social Decision", "Direct Brain Override", "Direct Action", "Constitution Modification"],
  "rules": {"candidate_only": true, "identity_protected": true, "current_reality_first": true, "brain_review_required": true, "emotion_is_context_only": true}
}
