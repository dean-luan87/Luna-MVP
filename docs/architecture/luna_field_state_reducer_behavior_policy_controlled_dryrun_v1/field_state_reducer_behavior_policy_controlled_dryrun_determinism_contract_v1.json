{
    "version": "1.0",
    "name": "Field State Reducer Behavior Policy Controlled DryRun Determinism Contract",
    "core_fields": [
        "candidate_policy_ids",
        "eligible_policy_ids",
        "rejected_policy_ids",
        "selected_policy_ids",
        "precedence_steps",
        "composition_sequence",
        "decision_outcome",
        "resulting_state_candidate",
        "replay_key",
        "policy_execution_executed",
        "state_mutation_executed",
        "fact_promotion_executed",
        "action_trigger_executed",
        "runtime_execution"
    ],
    "excluded_or_fixed_fields": [
        "created_at",
        "run_id",
        "process_id",
        "memory_address",
        "wall_clock_duration"
    ],
    "same_input_same_snapshot_same_result": true,
    "input_candidate_order_not_final_authority": true,
    "stable_policy_id_tie_breaker_required": true,
    "current_runtime_state_dependency_allowed": false,
