{
  "title": "Provider Adapter Contract v1",
  "owner": "Capability Governance",
  "pipeline": ["Capability", "Adapter", "Provider"],
  "adapter_input": ["Capability Request", "Execution Context", "Approved Input"],
  "adapter_output": ["Raw Result", "Provider Failure", "Timeout"],
