{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "luna://planning/intent/intent-candidate/v1",
  "title": "Intent Candidate v1",
  "description": "Planning-only subject-level Intent candidate; never a Decision, Action, Goal, Task, or truth claim.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "intent_id",
    "owner",
    "candidate_kind",
    "source_refs",
    "context_refs",
    "pcn_refs",
    "direction_candidate",
    "future_state_relation",
    "strength_candidate",
    "confidence_candidate",
    "priority_candidate",
    "truth_status",
    "uncertainty",
    "alternative_candidates",
    "provenance",
    "formation_trace",
    "state_candidate",
    "interaction_refs",
    "carryover_candidate",
    "resource_constraint_ref",
    "causal_handoff_eligible"
  ],
  "properties": {
    "intent_id": {"type": "string", "minLength": 1},
    "owner": {"const": "Intent Governance"},
    "candidate_kind": {"const": "INTENT_CANDIDATE"},
    "potential_intent_ref": {"anyOf": [{"$ref": "#/$defs/ref"}, {"type": "null"}]},
    "source_refs": {"type": "array", "items": {"$ref": "#/$defs/ref"}, "minItems": 1},
    "context_refs": {"type": "array", "items": {"$ref": "#/$defs/ref"}, "minItems": 1},
    "pcn_refs": {"type": "array", "items": {"$ref": "#/$defs/ref"}},
    "self_refs": {"type": "array", "items": {"$ref": "#/$defs/ref"}},
    "field_refs": {"type": "array", "items": {"$ref": "#/$defs/ref"}},
    "role_refs": {"type": "array", "items": {"$ref": "#/$defs/ref"}},
    "relationship_refs": {"type": "array", "items": {"$ref": "#/$defs/ref"}},
    "memory_refs": {"type": "array", "items": {"$ref": "#/$defs/ref"}},
    "experience_refs": {"type": "array", "items": {"$ref": "#/$defs/ref"}},
    "emotion_refs": {"type": "array", "items": {"$ref": "#/$defs/ref"}},
    "direction_candidate": {"type": "string", "minLength": 1},
    "future_state_relation": {"enum": ["SEEK", "AVOID", "MAINTAIN", "CHANGE", "UNKNOWN"]},
    "strength_candidate": {"type": ["number", "string", "null"]},
    "confidence_candidate": {"type": ["number", "string", "null"]},
    "priority_candidate": {"type": ["number", "string", "null"]},
    "truth_status": {"enum": ["UNKNOWN", "SUPPORTED_CANDIDATE", "CONTRADICTED_CANDIDATE"]},
    "uncertainty": {"type": "array", "items": {"type": "string"}},
    "alternative_candidates": {"type": "array", "items": {"$ref": "#/$defs/ref"}},
    "provenance": {"type": "array", "items": {"$ref": "#/$defs/ref"}, "minItems": 1},
    "formation_trace": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "state_candidate": {"type": "string", "minLength": 1},
    "interaction_refs": {"type": "array", "items": {"$ref": "#/$defs/ref"}},
    "carryover_candidate": {"type": "boolean"},
    "resource_constraint_ref": {"anyOf": [{"$ref": "#/$defs/ref"}, {"type": "null"}]},
    "causal_handoff_eligible": {"type": "boolean"}
  },
  "$defs": {
    "ref": {"type": "object", "required": ["owner", "ref_id"], "properties": {"owner": {"type": "string", "minLength": 1}, "ref_id": {"type": "string", "minLength": 1}}, "additionalProperties": true}
  },
  "dimension_independence": {
    "strength_not_confidence": true,
    "confidence_not_truth": true,
    "priority_not_decision": true,
    "dominance_not_decision": true
  },
  "active_schema": false
}
