{
  "title": "Situation Attention Interface v1",
  "contract_type": "Situation to Attention Interface",
  "inputs": {
    "situation_candidate": "current interpretation candidate",
    "unknown_context": [],
    "risk_context": {},
    "confidence": {},
    "field_context": {},
    "goal_context": {}
  },
  "outputs": {
    "attention_relevance_candidate": "candidate",
    "observation_requirement_candidate": "candidate",
    "uncertainty_reduction_candidate": "candidate",
    "reassessment_attention_candidate": "candidate"
  },
  "examples": {
