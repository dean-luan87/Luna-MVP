{
  "schema_version": "v1",
  "registry_type": "Capability Registry",
  "purpose": "capability identity and evidence boundary",
  "required_fields": ["capability_id", "capability_type", "input_contract", "output_evidence_contract", "limitations", "permission_reference", "lifecycle", "provenance"],
  "example": {
    "capability_id": "text_evidence_extraction",
    "capability_type": "visual_evidence",
    "input_contract": "image candidate",
    "output_evidence_contract": "text evidence candidate",
    "limitations": ["low_light", "distance", "occlusion"],
    "permission_reference": "evidence_only"
  },
  "forbidden_claims": ["world_understanding", "reality_interpretation", "decision", "brain_authority"],
  "registry_is_not_cognitive_subject": true,
  "direct_hardware_control": false
}
