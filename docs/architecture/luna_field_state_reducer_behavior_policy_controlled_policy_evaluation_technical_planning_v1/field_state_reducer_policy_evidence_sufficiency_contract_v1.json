        "source_id",
        "event_id",
        "event_time",
        "admission_id"
    ],
    "temporal_freshness_requirement": "event_age_within_policy_window",
    "contradiction_handling": "preserve_conflict_or_mark_unresolved",
    "no_evidence_fabrication": true,
    "insufficient_evidence_default": "unresolved_or_no_state_change",
    "fact_promotion_allowed": false,
    "evidence_sufficiency_contract_complete": true
}