    "model_or_provider_calls",
    "hardware_calls",
    "action_execution",
    "automatic_learning",
    "automatic_memory_consolidation",
    "automatic_growth_mutation",
    "b_route_simulation_runtime",
    "emotion_runtime",
    "role_runtime",
    "social_runtime",
    "world_model_creation",
    "reality_mutation",
    "provider_meaning_authority",
    "brain_direct_action"
