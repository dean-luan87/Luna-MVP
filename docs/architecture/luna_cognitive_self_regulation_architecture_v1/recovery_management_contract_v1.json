{
  "title": "Recovery Management Contract v1",
  "owner": "Self Regulation / Recovery Management",
  "pipeline": ["Failure", "Diagnosis", "Recovery Candidate", "Validation", "Apply Candidate", "Monitor"],
  "recovery_options": ["Current Version Restore", "Historical Version Candidate", "Alternate Model Candidate", "Alternate Provider Candidate", "Reduced Capability Mode"],
