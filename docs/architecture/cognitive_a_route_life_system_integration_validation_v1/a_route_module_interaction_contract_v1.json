{
  "contract_name": "A Route Module Interaction Contract v1",
  "modules": ["Reality", "Field", "Self", "Attention", "Situation", "Goal", "Task", "Option", "Decision", "Action", "Outcome", "Experience"],
  "ordered_flow": [
    "Reality", "Field", "Self", "Attention", "Situation", "Goal", "Task", "Option", "Decision", "Action", "Outcome", "Experience"
  ],
  "authority": {
    "Reality": ["fact representation", "unknown preservation"],
    "Field": ["context organization", "field lifecycle candidate"],
    "Self": ["Identity continuity", "Capability state", "current State"],
    "Attention": ["resource allocation candidate", "observation priority candidate"],
    "Situation": ["situated interpretation candidate"],
    "Goal": ["Brain-owned direction"],
    "Task": ["continuity and lifecycle"],
    "Option": ["candidate generation and tradeoff"],
    "Decision": ["candidate integration"],
    "Brain": ["Goal", "Value", "final Decision", "authorization"],
    "Action": ["request boundary only"],
    "Outcome": ["evidence and cause attribution"],
    "Experience": ["validated reference candidate"]
  },
  "forbidden_shortcuts": [
    "Capability to Decision",
    "Model to Goal",
    "Experience to Reality",
    "Field to Goal mutation",
    "Attention to Decision mutation",
    "Action to direct Reality mutation",
    "Task to automatic execution"
  ],
  "reality_update_requires_evidence_gateway": true,
  "reducer_is_sole_state_mutation_authority": true,
  "brain_is_final_goal_and_decision_authority": true,
  "provider_is_not_decision_authority": true,
  "runtime_execution_is_out_of_scope": true,
  "multi_a_is_out_of_scope": true,
  "unknowns_are_preserved": true
}
