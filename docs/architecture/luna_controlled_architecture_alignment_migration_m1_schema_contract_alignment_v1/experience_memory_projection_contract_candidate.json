        "mode": "outcome_validation_or_pattern_revision"
    },
    "revocation": {
        "supported": true,
        "mode": "withdraw_candidate_when_outcome_invalid"
    },
    "failure_behavior": {
        "on_missing_outcome": "emit_projection_unavailable_candidate",
        "on_admission_reject": "retain_nonpersistent_candidate",
        "on_boundary_violation": "block_experience_projection"
